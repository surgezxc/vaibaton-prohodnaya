NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8081
# 1 только в образе compose: страница https://<LAN>:8443 ходит в API и Keycloak на тот же адрес.
NEXT_PUBLIC_USE_PAGE_ORIGIN=0
NEXT_PUBLIC_KEYCLOAK_REALM=prohodnaya
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=web
# Только для next dev: имена хостов без протокола и порта, через запятую.
# Добавьте конкретный hostname своего HTTPS-туннеля, если он используется.
DEV_ALLOWED_ORIGINS=localhost,127.0.0.1
# Телефон должен открывать тот же HTTPS-origin, который зашифрован в QR.
# Эти адреса публичные; пароли и client secret здесь не нужны.
