# Скопируйте в apps/api/.env. Секретов здесь нет — подставьте свои локально.

PORT=3001
DATABASE_URL=postgres://prohodnaya:change-me@127.0.0.1:5432/prohodnaya

# На стенде токен проверяется по JWKS Keycloak. Issuer — тот iss, который видит браузер.
# Несколько значений через запятую: https://LAN:8443, http://LAN:8080 и localhost.
KEYCLOAK_ISSUER=http://localhost:8081/realms/prohodnaya
# Откуда API скачивает ключи. В compose это внутренний адрес, не localhost.
KEYCLOAK_JWKS_URL=http://127.0.0.1:8081/realms/prohodnaya/protocol/openid-connect/certs

# Пусто на стенде. Заполняется только для локальных тестов без Keycloak (HS256).
JWT_HMAC_SECRET=

# Контракт services/face. Пока сервис не поднят, decide отвечает «не готово».
FACE_SERVICE_URL=http://127.0.0.1:8000
FACE_TIMEOUT_MS=8000

ATTEMPT_TTL_SECONDS=25
LOCATION_INTERVAL_SECONDS=60

# gigachat | ollama
MODEL_PROVIDER=ollama
MODEL_TIMEOUT_MS=8000
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_BASE_URL=https://gigachat.devices.sberbank.ru/api/v1
GIGACHAT_API_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b

# Необязательно: файл промпта, если он уже лежит в репозитории.
PROMPTS_PATH=

WEB_ORIGIN=*
