# Скопируйте в .env. Паролей продакшена здесь нет.

POSTGRES_PASSWORD=change-me
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

MODEL_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:4b
GIGACHAT_API_KEY=
GIGACHAT_MODEL=GigaChat

WEB_ORIGIN=*

# Адрес ноутбука в Wi-Fi, без схемы и порта. Его открывают и ноутбук, и телефон.
# Linux: hostname -I | awk '{print $1}'
# macOS: ipconfig getifaddr en0
LAN_IP=

# Браузер на http://localhost по-прежнему может ходить сюда. Образ compose на https://LAN_IP:8443
# берёт API и Keycloak с адреса страницы и эти значения не использует.
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8081
