# Два входа одной страницы.
# Телефон: http://{$LAN_IP}:8080 без сертификата.
# Ноутбук и телефон с установленным ЦС: https://{$LAN_IP}:8443.
# Корень ЦС по-прежнему на HTTP :8088.
{
	admin off
	auto_https disable_redirects
	local_certs
}

:8088 {
	handle /ca.crt {
		root * /data/caddy/pki/authorities/local
		rewrite * /root.crt
		header Content-Type application/x-x509-ca-cert
		header Content-Disposition "attachment; filename=prohodnaya-ca.crt"
		file_server
	}
	handle {
		header Content-Type "text/plain; charset=utf-8"
		respond "Телефон без сертификата: http://{$LAN_IP}:8080/phone . ЦС для HTTPS: http://{$LAN_IP}:8088/ca.crt , затем https://{$LAN_IP}:8443" 200
	}
}

:8080 {
	@keycloak path_regexp ^/(realms|resources)(/.*)?$
	handle @keycloak {
		reverse_proxy keycloak:8080 {
			header_up Host {http.request.host}
			header_up X-Forwarded-Host {http.request.host}
			header_up X-Forwarded-Proto http
			header_up X-Forwarded-Port 8080
		}
	}
	@api path_regexp ^/(attempts|devices|people|zones|site|analytics|plans|locations|me|assistant|journal|directory)(/.*)?$
	handle @api {
		reverse_proxy api:3001
	}
	handle {
		reverse_proxy web:43123
	}
}

{$LAN_IP}:8443 {
	tls internal
	@keycloak path_regexp ^/(realms|resources)(/.*)?$
	handle @keycloak {
		reverse_proxy keycloak:8080 {
			header_up Host {http.request.host}
			header_up X-Forwarded-Host {http.request.host}
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-Port 8443
		}
	}
	@api path_regexp ^/(attempts|devices|people|zones|site|analytics|plans|locations|me|assistant|journal|directory)(/.*)?$
	handle @api {
		reverse_proxy api:3001
	}
	handle {
		reverse_proxy web:43123
	}
}
