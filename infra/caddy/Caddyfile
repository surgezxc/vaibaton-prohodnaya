# Один HTTPS-origin для ноутбука и телефона: https://{$LAN_IP}:8443
# Корень ЦС отдаётся по HTTP, пока телефон ещё не доверяет сертификату.
{
	admin off
	auto_https disable_redirects
	local_certs
}

:8088 {
	handle /ca.crt {
		root * /data/caddy/pki/authorities/local
		rewrite * /root.crt
		header Content-Type application/x-x509-ca-cert
		header Content-Disposition "attachment; filename=prohodnaya-ca.crt"
		file_server
	}
	handle {
		header Content-Type "text/plain; charset=utf-8"
		respond "Сертификат для Android: http://{$LAN_IP}:8088/ca.crt . Затем откройте https://{$LAN_IP}:8443" 200
	}
}

{$LAN_IP}:8443 {
	tls internal
	@keycloak path_regexp ^/(realms|resources)(/.*)?$
	handle @keycloak {
		reverse_proxy keycloak:8080 {
			header_up Host {http.request.host}
			header_up X-Forwarded-Host {http.request.host}
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-Port 8443
		}
	}
	@api path_regexp ^/(attempts|devices|people|zones|site|analytics|plans|locations|me|assistant|journal|directory)(/.*)?$
	handle @api {
		reverse_proxy api:3001
	}
	handle {
		reverse_proxy web:43123
	}
}
